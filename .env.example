# ─────────────────────────────────────────────────────────────────────────
# DMem configuration (environment variables only — no config file, no wizard).
# Copy to .env and edit. The adopter picks the tier EXPLICITLY; DMem never
# auto-detects it and never silently downgrades on missing config.
# ─────────────────────────────────────────────────────────────────────────

# Which storage tier to run. One of: sqlite | consolidated | pro
#   sqlite       — zero-setup default. No server. Weakest retrieval.
#   consolidated — one graph DB with native vectors (Neo4j 5.11+ or FalkorDB).
#   pro          — dedicated Postgres+pgvector (docs) + Graphiti graph (facts).
MEMORY_TIER=sqlite

# --- SQLite tier ----------------------------------------------------------
SQLITE_PATH=dmem.db

# --- Embeddings (bring-your-own vendor + key; nothing installed locally) -----
# EMBEDDING_PROVIDER selects the API shape:
#   openai   (default when a host URL is set) — OpenAI-compatible. Covers Qwen/
#            DashScope, vLLM, TEI, Ollama, Azure, Together, Fireworks, ... Just
#            point EMBEDDING_HOST_URL at your vendor's base URL.
#   google   — Google Gemini (native API; host URL optional)
#   cohere   — Cohere v2 (native API; host URL optional)
#   offline  — deterministic dev embedder, no network (low quality)
# If nothing is set, DMem uses the offline embedder and warns.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_HOST_URL=            # required for openai-compatible vendors
EMBEDDING_API_KEY=
# EMBEDDING_DIM=1024          # optional hint; discovered automatically otherwise

# Examples:
#   OpenAI:     EMBEDDING_PROVIDER=openai EMBEDDING_HOST_URL=https://api.openai.com/v1 EMBEDDING_MODEL=text-embedding-3-small
#   Qwen:       EMBEDDING_PROVIDER=qwen   EMBEDDING_HOST_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1 EMBEDDING_MODEL=text-embedding-v3
#   Google:     EMBEDDING_PROVIDER=google EMBEDDING_MODEL=text-embedding-004
#   Cohere:     EMBEDDING_PROVIDER=cohere EMBEDDING_MODEL=embed-v4.0

# --- Pro-tier document store (required if MEMORY_TIER=pro) -----------------
# Point at your EXISTING Postgres+pgvector — DMem creates only its own prefixed
# tables (IF NOT EXISTS), never touching yours. Change the prefix to avoid any
# collision or to run multiple DMem instances in one database.
PGVECTOR_URL=
# PGVECTOR_TABLE_PREFIX=dmem

# --- Graph backend (required if MEMORY_TIER=pro or consolidated) ----------
GRAPH_DB=neo4j             # neo4j | falkordb
GRAPH_DB_URL=              # bolt://host:7687  (neo4j)  or  redis://host:6379 (falkordb)
GRAPH_DB_USER=
GRAPH_DB_PASSWORD=
# GRAPH_DB_DATABASE=dmem

# --- OCR (optional; needed only to ingest binary documents like PDFs/images) --
# An endpoint that accepts raw bytes and returns markdown (e.g. self-hosted
# DeepSeek-OCR / Unlimited-OCR). Without it, only text/markdown docs ingest.
OCR_HOST_URL=
OCR_API_KEY=

# --- Fact-extraction / summarization LLM (optional; BYO chat endpoint) ----
# When set, used for high-quality typed extraction and compaction. When unset,
# a deterministic heuristic extractor is used (offline, lower recall).
LLM_MODEL=
LLM_HOST_URL=
LLM_API_KEY=

# --- Reranking (optional cross-encoder) -----------------------------------
RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # needs dmem[rerank]

# --- Retrieval / handoff tuning (safe day-one defaults) -------------------
HANDOFF_TOKEN_BUDGET=1200
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
RECENCY_HALF_LIFE_DAYS=30
LOW_CONFIDENCE_THRESHOLD=0.15
DMEM_NAMESPACE=default

# --- Production-safety policies -------------------------------------------
# Embedding-model change: vectors from different models aren't comparable, so a
# silent model swap corrupts retrieval. On mismatch with the stored signature:
#   warn (default) — log and continue   error — refuse to start   ignore — silent
# Recover after an intentional change by calling engine.reembed().
EMBEDDING_MISMATCH_POLICY=warn

# Credential facts (secret-bearing): how to handle extracted API keys/tokens/etc.
#   redact (default) — store the fact but mask the value and never embed it
#   drop             — do not store credential facts at all
#   store            — keep the raw value (still withheld from handoffs)
CREDENTIAL_POLICY=redact

# --- OpenAI-compatible proxy adapter (dmem.adapters.proxy) -----------------
# Only needed when running the transparent proxy (uvicorn dmem.adapters.proxy:app).
# PROXY_UPSTREAM_URL=https://api.openai.com/v1   # your OpenAI-compatible endpoint
# PROXY_UPSTREAM_API_KEY=sk-...                  # upstream provider key
# PROXY_INJECT_MEMORY=true            # inject relevant memory / model-switch handoff
# PROXY_COMPACT_HISTORY=true          # compact long histories before forwarding
# PROXY_COMPACT_OVER_TOKENS=3000      # compaction threshold
# PROXY_KEEP_LAST_TURNS=6             # turns kept verbatim after compaction
# PROXY_MEMORY_TOKEN_BUDGET=800       # budget for injected handoff / summary

# --- Contradiction handling (predicate cardinality) -----------------------
# SINGLE-valued predicates supersede on change (old value closed); MULTI-valued
# accumulate ("I use Postgres" and "I use Redis" are both true). Sensible
# defaults ship built in; these extend/override them (comma-separated).
# MULTI_VALUED_PREDICATES=uses,prefers,knows,owns
# SINGLE_VALUED_PREDICATES=works_at,lives_in
